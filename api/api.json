                                        "personero_id": {
                                            "type": "integer"
                                        },
                                        "document_number": {
                                            "type": "string"
                                        },
                                        "polling_stations": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "personero_id",
                                        "document_number",
                                        "polling_stations"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
