VITE_APP_NAME=ConteoYa
VITE_APP_ENV=production
VITE_APP_DEBUG=false
VITE_APP_URL=https://web.unifact.net.pe
VITE_API_BASE_URL=https://api.unifact.net.pe/api/v1
VITE_REVERB_APP_KEY=conteoya-reverb-key
VITE_REVERB_HOST=api.unifact.net.pe
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_MAPBOX_ACCESS_TOKEN=

# Control de Actividad en Vivo (Reverb / Polling)
# false: Pausa el tiempo real y polling para ahorrar CPU/RAM en VPS
VITE_ENABLE_REALTIME=false
VITE_REALTIME_POLLING_INTERVAL=30000
